	optdepends = wl-clipboard: copy to clipboard on Wayland (secret_fz -c)
	optdepends = xclip: copy to clipboard on X11 (secret_fz -c)
	optdepends = jq: back up to and restore from Bitwarden (secret backup, secrets-backup)
	optdepends = bitwarden-cli: back up to and restore from Bitwarden (secret backup, secrets-backup)
	source = nuvemlabs-secrets::git+https://github.com/nuvemlabs/secrets.git#tag=v1.2.0
	sha256sums = SKIP

pkgname = nuvemlabs-secrets
