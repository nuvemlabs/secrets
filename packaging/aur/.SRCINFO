pkgbase = nuvemlabs-secrets
	pkgdesc = OS-native secret storage for bash and zsh (libsecret, macOS Keychain, Windows Credential Manager)
	pkgver = 1.2.0
	pkgrel = 1
	url = https://github.com/nuvemlabs/secrets
	arch = any
	license = MIT
	checkdepends = jq
	makedepends = git
	depends = bash
	depends = libsecret
	depends = glib2
