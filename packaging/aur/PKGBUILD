# Maintainer: Daniel Paiva <danielpmo at gmail dot com>
pkgname=nuvemlabs-secrets
pkgver=1.1.1
pkgrel=1
pkgdesc="OS-native secret storage for bash and zsh (libsecret, macOS Keychain, Windows Credential Manager)"
arch=('any')
url="https://github.com/nuvemlabs/secrets"
license=('MIT')
depends=('bash' 'libsecret' 'glib2')
optdepends=('fzf: interactive picker (secret_fz)'
            'xclip: copy to clipboard (secret_fz -c)')
makedepends=('git')
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

check() {
  cd "$pkgname"
  # Hermetic suites only: the libsecret and API suites need a running
  # Secret Service, which a clean build chroot does not have.
  bash tests/test_file.sh
  bash tests/test_doctor.sh
  bash tests/test_install.sh
}

package() {
  cd "$pkgname"
  PREFIX=/usr DESTDIR="$pkgdir" bash install.sh
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
