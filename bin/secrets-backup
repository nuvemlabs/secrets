#!/bin/bash
# secrets-backup - Back up the secret store to Bitwarden and restore from it
#
# One Bitwarden folder per service, under a root folder (default "secrets"):
#   secrets/dotfiles/GROQ_API_KEY          login item, value in the password
#   secrets/secrets-bridge:proxmox-homelab/PVE_TOKEN_ID
#
# Bitwarden is a backup, not a backend: `bw` takes about a second per call and
# needs an unlocked session, far too slow for the lookups a shell does at start.
#
# Usage:
#   secrets-backup push [-a] [-n]           Copy secrets to Bitwarden
#   secrets-backup pull [-a] [-n] [--force] Copy secrets from Bitwarden
#
# Options:
#   -a, --all      Every service (push: in the store; pull: under the root folder)
#                  instead of $SECRETS_SERVICE only
#   -n, --dry-run  Report what would change, change nothing
#   --force        pull: overwrite a local value that differs from Bitwarden's
#                  (default: keep it and report it)
#
# Neither direction ever deletes anything: push creates and updates items,
# pull creates and (with --force) updates keys.
#
# Values never reach argv or the terminal: they go from the store to jq to bw
# (and back) over pipes, and only key names are printed.
#
# Exit: 0 done, 1 failed (bw missing or locked, a write failed), 2 usage.
#
# Configuration:
#   SECRETS_SERVICE     service to back up (default: library default)
#   SECRETS_BW_FOLDER   root Bitwarden folder (default: secrets)
#   SECRETS_LIB         library entry point (same lookup as secrets-doctor)
#   BW_SESSION          Bitwarden session; create with: export BW_SESSION=$(bw unlock --raw)

set -uo pipefail

usage() { sed -n '2,/^$/{s/^# \{0,1\}//;p}' "$0" | sed -n '/^Usage:/,$p'; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -z "${SECRETS_LIB:-}" ]]; then
    if [[ -f "$SCRIPT_DIR/../secrets.sh" ]]; then
        SECRETS_LIB="$SCRIPT_DIR/../secrets.sh"
    elif [[ -f "$SCRIPT_DIR/../lib/secrets/secrets.sh" ]]; then
        SECRETS_LIB="$SCRIPT_DIR/../lib/secrets/secrets.sh"
    else
        SECRETS_LIB="$HOME/.local/lib/secrets/secrets.sh"
    fi
fi

ROOT_FOLDER="${SECRETS_BW_FOLDER:-secrets}"
LOGIN_ITEM_TYPE=1
ITEM_NOTE="Backed up by secrets-backup (nuvemlabs/secrets); service and key are the folder and item name."

mode="${1:-}"
case "$mode" in
    push|pull) shift ;;
    -h|--help|help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

all=false dry_run=false force=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        -a|--all)     all=true ;;
        -n|--dry-run) dry_run=true ;;
        --force)      force=true ;;
        -h|--help)    usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done
[[ "$force" == true && "$mode" != pull ]] && { echo "--force only applies to pull" >&2; exit 2; }

for tool in bw jq; do
    command -v "$tool" &>/dev/null || { echo "secrets-backup: '$tool' is required" >&2; exit 1; }
done
[[ -f "$SECRETS_LIB" ]] || { echo "secrets-backup: library not found at $SECRETS_LIB" >&2; exit 1; }
# shellcheck source=/dev/null
source "$SECRETS_LIB"

bw_status=$(bw status 2>/dev/null | jq -r '.status // empty' 2>/dev/null)
if [[ "$bw_status" != unlocked ]]; then
    echo "secrets-backup: Bitwarden is ${bw_status:-unreachable}; unlock it first:" >&2
    # shellcheck disable=SC2016  # printed for the user to run, not expanded
    echo '  export BW_SESSION=$(bw unlock --raw)' >&2
    exit 1
fi
bw sync >/dev/null 2>&1 || echo "secrets-backup: bw sync failed; using the local vault cache" >&2

created=0 updated=0 unchanged=0 kept=0 failed=0
note() { printf '  %-10s %s\n' "$1" "$2"; }

# name -> id of every folder, refreshed after a create
folders_json=$(bw list folders 2>/dev/null) || { echo "secrets-backup: bw list folders failed" >&2; exit 1; }
folder_id() {
    jq -r --arg n "$1" 'first(.[] | select(.name == $n) | .id) // empty' <<<"$folders_json"
}

ensure_folder() {
    local name="$1" id
    id=$(folder_id "$name")
    if [[ -z "$id" && "$dry_run" == false ]]; then
        jq -nc --arg n "$name" '{name: $n}' | bw encode | bw create folder >/dev/null 2>&1 || return 1
        folders_json=$(bw list folders 2>/dev/null) || return 1
        id=$(folder_id "$name")
    fi
    echo "$id"
}

# The login item named KEY in the folder's item list, as JSON (empty if none)
item_in() { jq -c --arg k "$2" --argjson t "$LOGIN_ITEM_TYPE" 'first(.[] | select(.name == $k and .type == $t)) // empty' <<<"$1"; }

# Keys of one service in the store, one per line
store_keys() {
    local svc="$1"
    SECRETS_SERVICE="$svc" secret_list 2>/dev/null
}

push_service() {
    local svc="$1" folder="$ROOT_FOLDER/$1" fid items key item value remote
    echo "$svc -> $folder"
    fid=$(ensure_folder "$folder") || { note FAILED "creating folder $folder"; ((failed++)); return; }
    items="[]"
    [[ -n "$fid" ]] && { items=$(bw list items --folderid "$fid" 2>/dev/null) || { note FAILED "listing $folder"; ((failed++)); return; }; }

    while IFS= read -r key; do
        [[ -z "$key" ]] && continue
        value=$(SECRETS_SERVICE="$svc" secret_get "$key" 2>/dev/null) || { note FAILED "$key (unreadable in store)"; ((failed++)); continue; }
        item=$(item_in "$items" "$key")
        if [[ -z "$item" ]]; then
            if [[ "$dry_run" == false ]]; then
                printf '%s' "$value" | jq -Rsc --arg k "$key" --arg f "$fid" --arg n "$ITEM_NOTE" --argjson t "$LOGIN_ITEM_TYPE" \
                    '{type: $t, name: $k, folderId: $f, notes: $n, login: {password: .}}' \
                    | bw encode | bw create item >/dev/null 2>&1 || { note FAILED "$key (create)"; ((failed++)); continue; }
            fi
            note created "$key"; ((created++))
            continue
        fi
        remote=$(jq -j '.login.password // ""' <<<"$item")
        if [[ "$remote" == "$value" ]]; then
            ((unchanged++))
            continue
        fi
        if [[ "$dry_run" == false ]]; then
            # The item (old password included) and the new value both go in on
            # stdin, NUL-separated, since --argjson would put them in argv.
            { printf '%s' "$item"; printf '\0'; printf '%s' "$value"; } \
                | jq -Rsc 'split("\u0000") as $p | ($p[0] | fromjson) | .login.password = ($p[1:] | join("\u0000"))' \
                | bw encode | bw edit item "$(jq -r .id <<<"$item")" >/dev/null 2>&1 || { note FAILED "$key (update)"; ((failed++)); continue; }
        fi
        note updated "$key"; ((updated++))
    done < <(store_keys "$svc")
}

pull_service() {
    local svc="$1" folder="$ROOT_FOLDER/$1" fid items key value local_value
    echo "$folder -> $svc"
    fid=$(folder_id "$folder")
    [[ -z "$fid" ]] && { note missing "no folder $folder in Bitwarden"; return; }
    items=$(bw list items --folderid "$fid" 2>/dev/null) || { note FAILED "listing $folder"; ((failed++)); return; }

    while IFS= read -r key; do
        [[ -z "$key" ]] && continue
        value=$(jq -j --arg k "$key" --argjson t "$LOGIN_ITEM_TYPE" \
            'first(.[] | select(.name == $k and .type == $t)) | .login.password // ""' <<<"$items")
        [[ -z "$value" ]] && { note skipped "$key (empty in Bitwarden)"; continue; }
        if local_value=$(SECRETS_SERVICE="$svc" secret_get "$key" 2>/dev/null); then
            if [[ "$local_value" == "$value" ]]; then
                ((unchanged++)); continue
            fi
            if [[ "$force" == false ]]; then
                note kept "$key (differs locally; --force to overwrite)"; ((kept++)); continue
            fi
            [[ "$dry_run" == false ]] && { SECRETS_SERVICE="$svc" secret_set "$key" "$value" || { note FAILED "$key"; ((failed++)); continue; }; }
            note updated "$key"; ((updated++))
        else
            [[ "$dry_run" == false ]] && { SECRETS_SERVICE="$svc" secret_set "$key" "$value" || { note FAILED "$key"; ((failed++)); continue; }; }
            note created "$key"; ((created++))
        fi
    done < <(jq -r --argjson t "$LOGIN_ITEM_TYPE" '.[] | select(.type == $t) | .name' <<<"$items" | sort -u)
}

services=()
if [[ "$all" == false ]]; then
    services=("$SECRETS_SERVICE")
elif [[ "$mode" == push ]]; then
    # list -a prints service:key and service names may hold a colon, so split at the last one
    while IFS= read -r svc; do services+=("$svc"); done < <(secret_list -a 2>/dev/null | sed 's/:[^:]*$//' | sort -u)
else
    while IFS= read -r svc; do services+=("$svc"); done < <(
        jq -r --arg p "$ROOT_FOLDER/" '.[].name | select(startswith($p)) | ltrimstr($p)' <<<"$folders_json" | sort -u)
fi
[[ ${#services[@]} -eq 0 ]] && { echo "Nothing to $mode." >&2; exit 0; }

[[ "$dry_run" == true ]] && echo "(dry run: nothing is changed)"
for svc in "${services[@]}"; do
    "${mode}_service" "$svc"
done

echo "created $created, updated $updated, unchanged $unchanged$([[ $kept -gt 0 ]] && echo ", kept $kept")$([[ $failed -gt 0 ]] && echo ", FAILED $failed")"
[[ $failed -eq 0 ]]
