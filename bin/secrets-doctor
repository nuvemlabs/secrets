#!/bin/bash
# secrets-doctor - Diagnose secret propagation without ever printing values.
#
# Checks each key across the links of the secrets chain and reports where
# it breaks:
#   STORE    - OS secret store (secrets library, one entry per key)
#   EXPORTS  - export line in the shell file that maps store keys to env vars
#   ENV      - variable non-empty in the invoking shell's environment
#
# Usage:
#   secrets-doctor                   # check every key the exports file reads
#   secrets-doctor AZDO_PAT          # check specific key(s)
#   secrets-doctor PIPELINE_GUARD    # a non-exact name expands as a prefix
#
# Options:
#   --probe          also validate stored VALUES in-process: flags empty
#                    entries and embedded newlines/control chars. The value
#                    is read into this process's memory but never printed,
#                    never passed as an argument, never exported.
#   --match REGEX    with --probe (implied): stored value and env value must
#                    match REGEX, e.g. --match '^.{20,}$' for a length floor.
#                    Only the pass/fail fact is reported.
#
# Configuration (environment):
#   SECRETS_EXPORTS_FILE  shell file with `export KEY="$(secret KEY)"` lines;
#                         falls back to $DOTFILES_DIR/config/shell/secrets.sh,
#                         else the EXPORTS column reports n/a and the default
#                         key set becomes the store listing
#   SECRETS_LIB           library entry point; defaults to a sibling checkout
#                         (../secrets.sh) then ~/.local/lib/secrets/secrets.sh
#   SECRETS_SERVICE       store namespace; else parsed from the exports file,
#                         else the library default
#
# Exit codes: 0 = chain intact for all keys, 1 = at least one break,
#             2 = usage or setup error
#
# Leak-proof by design: by default store presence comes from key listings
# (secret_list) and exports from grep on names — no code path reads a
# secret's value. --probe relaxes this to "read but never output": checks
# use bash built-ins only, so the value never leaves the process.
#
# Run it from (or as a child of) the shell you are diagnosing: the ENV column
# reflects the environment this script inherits.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -z "${SECRETS_LIB:-}" ]]; then
    if [[ -f "$SCRIPT_DIR/../secrets.sh" ]]; then
        SECRETS_LIB="$SCRIPT_DIR/../secrets.sh"      # running from a checkout
    else
        SECRETS_LIB="$HOME/.local/lib/secrets/secrets.sh"
    fi
fi

EXPORTS_FILE="${SECRETS_EXPORTS_FILE:-}"
if [[ -z "$EXPORTS_FILE" && -n "${DOTFILES_DIR:-}" && -f "$DOTFILES_DIR/config/shell/secrets.sh" ]]; then
    EXPORTS_FILE="$DOTFILES_DIR/config/shell/secrets.sh"
fi

usage() {
    sed -n '2,44p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

probe=0
match_re=""
args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --probe)   probe=1; shift ;;
        --match)
            if [[ -z "${2:-}" ]]; then
                echo "Error: --match requires a regex argument" >&2
                exit 2
            fi
            match_re="$2"; probe=1; shift 2 ;;
        -*)
            echo "Error: unknown option '$1' (see --help)" >&2
            exit 2 ;;
        *) args+=("$1"); shift ;;
    esac
done
set -- ${args+"${args[@]}"}

# Probing reads values into memory: make sure an inherited xtrace
# (exported SHELLOPTS) cannot echo them.
[[ $probe -eq 1 ]] && { set +x; } 2>/dev/null

# Uncommented lines of the exports file, reused by every parse below
exports_available=0
exports_src=""
if [[ -n "$EXPORTS_FILE" && -f "$EXPORTS_FILE" ]]; then
    exports_available=1
    exports_src="$(grep -vE '^[[:space:]]*#' "$EXPORTS_FILE")"
else
    echo "Warning: no exports file (set SECRETS_EXPORTS_FILE) — EXPORTS column unavailable" >&2
fi

# Service namespace: honor the environment, otherwise read the one the
# exports file itself uses, falling back to the library default.
if [[ -z "${SECRETS_SERVICE:-}" && $exports_available -eq 1 ]]; then
    SECRETS_SERVICE="$(grep -oE 'SECRETS_SERVICE="[^"]+"' <<<"$exports_src" | head -1 | cut -d'"' -f2)"
fi
[[ -n "${SECRETS_SERVICE:-}" ]] && export SECRETS_SERVICE

# Canonical keys: every KEY the exports file reads via $(secret KEY ...)
# Exported keys: every name the exports file exports (includes derived aliases)
canonical_keys=""
exported_keys=""
if [[ $exports_available -eq 1 ]]; then
    canonical_keys="$(grep -oE '\$\(secret [A-Za-z_][A-Za-z0-9_]*' <<<"$exports_src" | awk '{print $2}' | sort -u)"
    exported_keys="$(grep -oE '^[[:space:]]*export [A-Za-z_][A-Za-z0-9_]*=' <<<"$exports_src" | grep -oE '[A-Za-z_][A-Za-z0-9_]*=' | sed 's/=$//' | sort -u)"
fi

# Keys present in the secret store (names only — values are never read)
store_keys=""
store_available=0
if [[ -f "$SECRETS_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$SECRETS_LIB"
    store_keys="$(secret_list 2>/dev/null | sort -u)"
    store_available=1
else
    echo "Warning: secrets library not found at $SECRETS_LIB — store checks unavailable" >&2
fi

if [[ $exports_available -eq 0 && $store_available -eq 0 ]]; then
    echo "Error: neither an exports file nor the secrets library is available" >&2
    exit 2
fi

has_line() { grep -qxF "$2" <<<"$1"; }

# Resolve requested names: exact key, or prefix over canonical ∪ store keys
all_known="$(printf '%s\n%s\n%s\n' "$canonical_keys" "$store_keys" "$exported_keys" | grep -v '^$' | sort -u)"
if [[ $# -gt 0 ]]; then
    keys=""
    unmatched=0
    for arg in "$@"; do
        if has_line "$all_known" "$arg"; then
            keys+="$arg"$'\n'
        else
            matches="$(grep -E "^${arg}" <<<"$all_known")"
            if [[ -n "$matches" ]]; then
                keys+="$matches"$'\n'
            else
                echo "Warning: no key matches '$arg' (checked as-is)" >&2
                keys+="$arg"$'\n'
                unmatched=1
            fi
        fi
    done
    keys="$(sort -u <<<"${keys%$'\n'}")"
else
    # Default set: keys the exports file reads; else everything in the store
    keys="${canonical_keys:-$store_keys}"
    unmatched=0
    if [[ -z "$keys" ]]; then
        echo "Error: no keys found to check (empty exports file and store)" >&2
        exit 2
    fi
fi

broken=$unmatched
printf '%-38s %-10s %-16s %s\n' "KEY" "STORE" "EXPORTS" "ENV"
while IFS= read -r key; do
    [[ -z "$key" ]] && continue

    # EXPORTS: uncommented `export KEY=` line; derived = assigned from
    # another variable rather than read from the store itself
    if [[ $exports_available -eq 0 ]]; then
        exports_col="n/a"
        kind="direct"
    else
        export_line="$(grep -nE "^[[:space:]]*export ${key}=" "$EXPORTS_FILE" | grep -vE ':[[:space:]]*#' | head -1 | cut -d: -f1)"
        if [[ -n "$export_line" ]]; then
            if has_line "$canonical_keys" "$key"; then
                exports_col="L${export_line}"
                kind="direct"
            else
                exports_col="L${export_line} (derived)"
                kind="derived"
            fi
        else
            exports_col="MISSING"
            kind="absent"
        fi
    fi

    # STORE: n/a for derived vars (they alias another key's value)
    if [[ "$kind" == "derived" ]]; then
        store_col="n/a"
        store_ok=1
    elif [[ $store_available -eq 0 ]]; then
        store_col="unknown"
        store_ok=1
    elif has_line "$store_keys" "$key"; then
        if [[ $probe -eq 1 ]]; then
            # Value stays in this variable only: bash built-in tests, no
            # child processes, no output. Facts about it, never the value.
            probe_val="$(secret "$key" 2>/dev/null)"
            if [[ -z "$probe_val" ]]; then
                store_col="EMPTY"
                store_ok=0
            elif [[ "$probe_val" == *$'\n'* || "$probe_val" == *$'\t'* || "$probe_val" == *$'\r'* ]]; then
                store_col="ctrl-chars"
                store_ok=0
            elif [[ -n "$match_re" && ! "$probe_val" =~ $match_re ]]; then
                store_col="no-match"
                store_ok=0
            else
                store_col="ok*"
                store_ok=1
            fi
            unset probe_val
        else
            store_col="ok"
            store_ok=1
        fi
    else
        store_col="MISSING"
        store_ok=0
    fi

    # ENV: non-empty in the inherited environment (empty counts as missing —
    # an export line whose $(secret ...) returned nothing still sets the var)
    if [[ -n "${!key-}" ]]; then
        if [[ -n "$match_re" && ! "${!key}" =~ $match_re ]]; then
            env_col="no-match"
            env_ok=0
        else
            env_col="set"
            env_ok=1
        fi
    else
        env_col="MISSING"
        env_ok=0
    fi

    [[ $store_ok -eq 1 && $env_ok -eq 1 && "$kind" != "absent" ]] || broken=1
    printf '%-38s %-10s %-16s %s\n' "$key" "$store_col" "$exports_col" "$env_col"
done <<<"$keys"

[[ $probe -eq 1 ]] && echo "ok* = value probed in-process: non-empty, no control chars${match_re:+, matches --match}"

exit $broken
